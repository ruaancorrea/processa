<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Gate de cobertura do CI (docs/02-arquitetura/decisoes/adr-010-ci-cd-gitflow.md): 80% de linha,
    medido pelo total agregado (não pelo mínimo por assembly — módulos ainda sem lógica de
    domínio real não devem travar o gate até ganharem testes próprios nos sprints seguintes).
    Rodar: dotnet test tests/Processa.UnitTests -c Release

    Exclusões: glue code de acesso a dado (DbContext, repositórios EF, migrations, wiring de
    DI) não tem branch de negócio para unit test cobrir com sinal real — é validado de verdade
    por Processa.IntegrationTests contra Postgres real (Testcontainers), não por aqui. Ver
    .faf/decisions.faf. Domain e Application (onde vive a regra de negócio) permanecem 100%
    dentro do gate — nenhuma exclusão ali.
  -->
  <PropertyGroup>
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <Threshold>80</Threshold>
    <ThresholdType>line</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
    <Exclude>[Processa.Modules.Identidade]Processa.Modules.Identidade.Infrastructure.Migracoes.*,[Processa.Modules.Identidade]Processa.Modules.Identidade.Infrastructure.Repositorios.*,[Processa.Modules.Identidade]Processa.Modules.Identidade.Infrastructure.IdentidadeDbContext,[Processa.Modules.Identidade]Processa.Modules.Identidade.Infrastructure.IdentidadeModuleServiceCollectionExtensions,[Processa.Modules.Identidade]Processa.Modules.Identidade.Infrastructure.HttpContextTenantContext,[Processa.Modules.Identidade]Processa.Modules.Identidade.Infrastructure.Configuracoes.*,[Processa.Modules.Identidade]Processa.Modules.Identidade.Presentation.*,[Processa.Modules.Identidade]Processa.Modules.Identidade.Infrastructure.VerificadorMembroEquipe,[Processa.Modules.Identidade]Processa.Modules.Identidade.Infrastructure.VerificadorEquipe,[Processa.Modules.Identidade]Processa.Modules.Identidade.Infrastructure.VerificadorUsuario,[Processa.Modules.Identidade]Processa.Modules.Identidade.Infrastructure.HttpContextUsuarioContext,[Processa.Modules.Identidade]Processa.Modules.Identidade.Infrastructure.ListadorMembrosEquipe,[Processa.Modules.Clientes]Processa.Modules.Clientes.Infrastructure.Migracoes.*,[Processa.Modules.Clientes]Processa.Modules.Clientes.Infrastructure.Repositorios.*,[Processa.Modules.Clientes]Processa.Modules.Clientes.Infrastructure.ClientesDbContext,[Processa.Modules.Clientes]Processa.Modules.Clientes.Infrastructure.ClientesModuleServiceCollectionExtensions,[Processa.Modules.Clientes]Processa.Modules.Clientes.Infrastructure.Configuracoes.*,[Processa.Modules.Clientes]Processa.Modules.Clientes.Presentation.*,[Processa.Modules.Processos]Processa.Modules.Processos.Infrastructure.Migrations.*,[Processa.Modules.Processos]Processa.Modules.Processos.Infrastructure.Repositorios.*,[Processa.Modules.Processos]Processa.Modules.Processos.Infrastructure.ProcessosDbContext,[Processa.Modules.Processos]Processa.Modules.Processos.Infrastructure.ProcessosModuleServiceCollectionExtensions,[Processa.Modules.Processos]Processa.Modules.Processos.Infrastructure.Configuracoes.*,[Processa.Modules.Processos]Processa.Modules.Processos.Presentation.*,[Processa.Modules.Processos]Processa.Modules.Processos.Infrastructure.ClienteHttpEtapa,[Processa.Modules.Processos]Processa.Modules.Processos.Infrastructure.NotificadorEtapa,[Processa.Modules.Processos]Processa.Modules.Processos.Infrastructure.ArmazenamentoArquivoS3</Exclude>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Processa.Modules.Processos\Processa.Modules.Processos.csproj" />
    <ProjectReference Include="..\..\src\Processa.Shared.Kernel\Processa.Shared.Kernel.csproj" />
    <ProjectReference Include="..\..\src\Processa.Modules.Identidade\Processa.Modules.Identidade.csproj" />
    <ProjectReference Include="..\..\src\Processa.Modules.Clientes\Processa.Modules.Clientes.csproj" />
  </ItemGroup>

</Project>