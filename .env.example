# Copie para .env e preencha os valores reais. Nunca versione o .env.

POSTGRES_USER=processa
POSTGRES_PASSWORD=
POSTGRES_DB=processa
POSTGRES_PORT=5432

REDIS_PORT=6379

RABBITMQ_USER=processa
RABBITMQ_PASSWORD=
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

MINIO_ROOT_USER=processa
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Autenticação (Sprint 1) — usado só pelo perfil "app" (API containerizada);
# em dev local (dotnet run) os valores vêm de appsettings.Development.json.
JWT_SECRET_KEY=
JWT_ISSUER=processa-api
JWT_AUDIENCE=processa-app

# Cifragem de credenciais de integrações externas (Sprint 6+)
FERNET_KEY=
